{
  "manifest_version": 3,
  "name": "SepetIQ",
  "version": "0.1.0",
  "description": "AI destekli alışveriş asistanı",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*/*"],
  "action": {
    "default_popup": "index.html",
    "default_title": "SepetIQ"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["src/content/index.tsx"]
    }
  ]
}
